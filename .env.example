# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
# The agent LLM client (src/battery_aar/agents/llm_client.py) reads these. It
# falls back across the OPEN_BATTERY_AGENTS_* names first, then the STANFORD_AI_*
# names, so you only need ONE provider configured. All offline / non-LLM paths
# (e.g. `make attia-reference-smoke`, the offline rediscovery loop) run without
# any of these set.

# --- Primary provider (OpenAI-compatible endpoint) ---
OPEN_BATTERY_AGENTS_API_KEY=sk-your-key-here
OPEN_BATTERY_AGENTS_BASE_URL=https://api.openai.com/v1
OPEN_BATTERY_AGENTS_MODEL=gpt-4o-mini
# Optional: send a model alias via a custom header (gateway-specific).
OPEN_BATTERY_AGENTS_ALIAS=
OPEN_BATTERY_AGENTS_ALIAS_HEADER=
# Optional: extra HTTP headers as a JSON object, e.g. {"X-Org":"darve"}.
OPEN_BATTERY_AGENTS_EXTRA_HEADERS_JSON=

# --- Fallback provider (Stanford AI gateway) ---
STANFORD_AI_API_KEY=
STANFORD_AI_BASE_URL=
STANFORD_AI_ALIAS=
